{
    "schema": "http://jhnnsrs-lab/elektro/schema",
    "documents": "graphql/**/**.graphql",
    "extensions": {
        "turms": {
            "domain": null,
            "out_dir": "elektro/api",
            "dump_configuration": true,
            "configuration_name": "project.json",
            "dump_schema": true,
            "schema_name": "schema.graphql",
            "generated_name": "schema.py",
            "documents": "graphql/**/**.graphql",
            "verbose": false,
            "exit_on_error": true,
            "allow_introspection": true,
            "object_bases": [
                "pydantic.BaseModel"
            ],
            "interface_bases": null,
            "always_resolve_interfaces": true,
            "exclude_typenames": true,
            "scalar_definitions": {
                "Any": "typing.Any",
                "JSON": "typing.Any",
                "UUID": "str",
                "AnyDefault": "typing.Any",
                "SearchQuery": "str",
                "Arg": "typing.Any",
                "ValidatorFunction": "str",
                "StructureString": "str",
                "ArrayLike": "elektro.scalars.ArrayLike",
                "FileLike": "elektro.scalars.FileLike",
                "BigFileLike": "elektro.scalars.BigFileLike",
                "ParquetLike": "elektro.scalars.ParquetLike",
                "SporadikLike": "elektro.scalars.SporadikLike",
                "Upload": "elektro.scalars.Upload",
                "Vector": "elektro.scalars.Vector",
                "TwoDVector": "elektro.scalars.TwoDVector",
                "ThreeDVector": "elektro.scalars.ThreeDVector",
                "FourDVector": "elektro.scalars.FourDVector",
                "FiveDVector": "elektro.scalars.FiveDVector",
                "Matrix": "elektro.scalars.Matrix",
                "Metric": "typing.Any",
                "Ampere": "kanne.scalars.Ampere",
                "ID": "rath.scalars.ID",
                "RGBAColor": "elektro.scalars.RGBAColor",
                "Frequency": "kanne.scalars.Frequency",
                "Duration": "kanne.scalars.Duration",
                "Length": "kanne.scalars.Length",
                "ElectricPotential": "kanne.scalars.ElectricPotential",
                "ElectricalConductance": "kanne.scalars.ElectricalConductance",
                "ElectricCurrent": "kanne.scalars.ElectricCurrent",
                "ElectricalResistance": "kanne.scalars.ElectricalResistance",
                "Capacitance": "kanne.scalars.Capacitance",
                "Temperature": "kanne.scalars.Temperature",
                "Resistivity": "kanne.scalars.Resistivity",
                "SpecificCapacitance": "kanne.scalars.SpecificCapacitance",
                "Concentration": "kanne.scalars.Concentration",
                "GenericQuantity": "kanne.scalars.GenericQuantity",
                "Unit": "kanne.scalars.Unit",
                "Dimension": "kanne.scalars.Dimension"
            },
            "coercible_scalars": {
                "ArrayLike": "elektro.scalars.ArrayCoercible",
                "ID": "rath.scalars.IDCoercible",
                "FileLike": "elektro.scalars.FileLikeCoercible",
                "BigFileLike": "elektro.scalars.BigFileLikeCoercible",
                "ParquetLike": "elektro.scalars.ParquetCoercible",
                "SporadikLike": "elektro.scalars.SporadikCoercible"
            },
            "coercible_inputs": {},
            "graphql_default_class": null,
            "deprecated_class": null,
            "document_field_metadata": true,
            "unset_type_class": null,
            "unset_instance": null,
            "freeze": {
                "enabled": false,
                "types": [
                    "input",
                    "fragment",
                    "object"
                ],
                "exclude": null,
                "include": null,
                "convert_list_to_tuple": true
            },
            "create_catchall": true,
            "options": {
                "enabled": true,
                "extra": "forbid",
                "populate_by_name": null,
                "from_attributes": null,
                "use_enum_values": null,
                "validate_assignment": true,
                "alias_mode": "split",
                "types": [
                    "input"
                ],
                "exclude": null,
                "include": null
            },
            "skip_forwards": false,
            "min_python_version": "3.10",
            "type_annotation_style": "auto",
            "external_modules": [],
            "additional_bases": {
                "ArrayDataset": [
                    "elektro.traits.DatasetTrait"
                ],
                "DataArray": [
                    "elektro.traits.DataArrayTrait"
                ],
                "Biophysics": [
                    "elektro.traits.BiophysicsTrait"
                ],
                "Topology": [
                    "elektro.traits.TopologyTrait"
                ],
                "Compartment": [
                    "elektro.traits.CompartmentTrait"
                ],
                "SectionInput": [
                    "elektro.traits.SectionInputTrait"
                ],
                "ModelConfig": [
                    "elektro.traits.ModelConfigTrait"
                ],
                "Experiment": [
                    "elektro.traits.ExperimentTrait"
                ],
                "BiophysicsInput": [
                    "elektro.traits.BiophysicsInputTrait"
                ],
                "CompartmentInput": [
                    "elektro.traits.CompartmentInputTrait"
                ],
                "ModelConfigInput": [
                    "elektro.traits.ModelConfigInputTrait"
                ],
                "TopologyInput": [
                    "elektro.traits.TopologyInputTrait"
                ],
                "ZarrStore": [
                    "elektro.traits.HasZarrStoreAccessor"
                ],
                "ParquetStore": [
                    "elektro.traits.HasParquetStoreAccesor"
                ],
                "BigFileStore": [
                    "elektro.traits.HasDownloadAccessor"
                ],
                "MediaStore": [
                    "elektro.traits.HasPresignedDownloadAccessor"
                ],
                "Lens": [
                    "elektro.traits.Lensable"
                ],
                "CoordinateSystem": [
                    "elektro.traits.CoordinateSystemTrait"
                ],
                "ScaleTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "TranslationTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "AffineTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "RotationTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "IdentityTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "MapAxisTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "FieldTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "SequenceTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "ByDimensionTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "UnmappableTransformation": [
                    "elektro.traits.TransformationTrait"
                ],
                "AxisInput": [
                    "elektro.traits.AxisInputTrait"
                ],
                "CreateArrayDatasetInput": [
                    "elektro.traits.DeclaresAxesTrait"
                ],
                "TableDataset": [
                    "elektro.traits.TableDatasetTrait"
                ],
                "CreateTableDatasetInput": [
                    "elektro.traits.CreateTableDatasetTrait"
                ],
                "CreateSparseDatasetInput": [
                    "elektro.traits.CreateSparseDatasetTrait"
                ],
                "SparseAxisInput": [
                    "elektro.traits.SparseAxisInputTrait"
                ],
                "CreateSamplingLawInput": [
                    "elektro.traits.ResolvesSpacesTrait"
                ],
                "CreateClockOffsetInput": [
                    "elektro.traits.ResolvesSpacesTrait"
                ],
                "CreateSessionInput": [
                    "elektro.traits.ResolvesSpacesTrait"
                ]
            },
            "additional_config": {},
            "force_plugin_order": true,
            "omitted_document_rules": [],
            "parsers": [],
            "plugins": [
                {
                    "type": "turms.plugins.enums.EnumsPlugin"
                },
                {
                    "type": "turms.plugins.inputs.InputsPlugin"
                },
                {
                    "type": "turms.plugins.fragments.FragmentsPlugin",
                    "object_bases": [
                        "elektro.traits.ElektroFetchable"
                    ]
                },
                {
                    "type": "turms.plugins.operations.OperationsPlugin"
                },
                {
                    "type": "turms.plugins.input_funcs.InputFuncsPlugin"
                },
                {
                    "type": "turms.plugins.client.ClientPlugin",
                    "client_class": "ElektroApi",
                    "global_kwargs": [
                        {
                            "key": "task",
                            "type": "rath.task.TaskLike",
                            "description": "The task this call is made for; the ambient one by default."
                        }
                    ],
                    "reserved_from": [
                        "koil.composition.Composition"
                    ],
                    "reserved_names": [
                        "rath",
                        "datalayer",
                        "task_token",
                        "for_task"
                    ],
                    "coercible_inputs": {
                        "AxisInput": "str"
                    },
                    "expand_input_types": [
                        "input"
                    ]
                }
            ],
            "processors": [
                {
                    "type": "turms.processors.disclaimer.DisclaimerProcessor"
                }
            ],
            "stylers": [
                {
                    "type": "turms.stylers.default.DefaultStyler"
                },
                {
                    "type": "turms.stylers.appender.AppenderStyler",
                    "append_fragment": ""
                }
            ]
        }
    }
}
